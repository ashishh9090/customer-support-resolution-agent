# AI Customer Support Resolution Agent Environment Variables

# Environment & Server
ENV=development
API_V1_STR=/api/v1
PROJECT_NAME="Production-Style AI Customer Support Resolution Agent"

# Database Configuration
# Default: SQLite zero-dependency local mode
DATABASE_URL=sqlite:///./support_agent.db
# PostgreSQL mode (e.g. Docker Compose or Cloud SQL):
# DATABASE_URL=postgresql+psycopg2://support_user:support_pass@localhost:5432/support_db

# Security & JWT Auth
SECRET_KEY=dev-insecure-secret-key-change-in-production-support-agent-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Orchestration
# Set to "mock" for deterministic test and evaluation runs without external API keys
LLM_PROVIDER=mock
# When using live LLM providers, set one of the following:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=...
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Refund Policies & Safeguards
AUTO_REFUND_LIMIT_USD=50.00
MAX_REFUNDS_PER_90_DAYS=2
REFUND_WINDOW_DAYS=30
DAMAGED_REPORT_WINDOW_DAYS=14
